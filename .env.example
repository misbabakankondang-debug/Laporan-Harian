# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================================
# SUPABASE CONFIGURATION (Frontend - React + Vite)
# ====================================================================
# VITE_SUPABASE_URL: Project URL dari Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY: Public Anon Key dari Supabase Project Settings > API
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# (Opsional - alias untuk backward compatibility)
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# ====================================================================
# SUPABASE CONFIGURATION (Backend / Vercel Serverless Functions)
# ====================================================================
# Hanya dimasukkan di Vercel Project Settings > Environment Variables (JANGAN publikasikan)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
